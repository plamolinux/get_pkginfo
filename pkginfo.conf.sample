# configuration file for get_pkginfo
#-----------------------------------------------------------------
# Plamo Linux の更新パッケージを確認してダウンロードするスクリプト
#-----------------------------------------------------------------

# URL
# チェック/ダウンロード先の UR
#
#URL = http://repository.plamolinux.org/pub/linux/Plamo/

# DOWNLOAD
# ダウンロードしたパッケージの格納方法を linear か subdir に
# する．linear の場合，単一のディレクトリに収める．subdir の
# 場合，カテゴリごとのサブディレクトリに収める．
#
#DOWNLOAD = linear

# DOWNTODIR
# ダウンロードしたパッケージの置き場所(要書き込みパーミッション)
# (ex: /var/Newpkgs)．デフォルトでは $CWD
#
#DOWNTODIR = /var/Newpkgs

# CATEGORY
# インストールしたカテゴリに関わらずチェックしたいカテゴリを
# 指定する．all を指定した場合，全カテゴリをチェックする．
#
#CATEGORY = 00_base 03_libs

# LOCALBLOCK
# ブロックしたいパッケージ名．一行にベース名をスペース区切りで連ねて書く.
# デフォルトでは完全一致だが、部分一致で複数パッケージをブロックしたい場合、
# マークとして'*'を使う。
# '*'はregexではなく部分一致用のマーカーで、"mozc*"や"*mozc"、"mo*zc"の指定で、
# mozc や emacs_mozc, mozc_hogehoge にマッチする。
# 
#LOCALBLOCK = man man_db ffmpeg mplayer

# INSTALL
# 自動インストールのモードを auto か manual にする．manual
# の場合，各パッケージのインストール前に確認する．auto の場
# 合は問い合わせずにインストールを進める．
#
#INSTALL = auto

# BLOCKLIST
# ブロックリスト機能の有無．
#
#BLOCKLIST = True

# REVERSE
# ローカルにインストールされていないパッケージを表示する．
#
#REVERSE = False

# KEEP
# インストール済みのパッケージのみをチェックする
# デフォルトはカテゴリー単位でチェック
#
# KEEP = False

